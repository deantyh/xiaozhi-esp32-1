{
    "type": "bread-compact-wifi-s3cam",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-s3cam",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": false
            },
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y"
            ]
        },
        {
            "name": "bread-compact-wifi-s3cam-240x320-dl",
            "build_options": {
                "camera_hmirror": true,
                "camera_vflip": false
            },
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y",
                "CONFIG_BREAD_COMPACT_WIFI_CAM_POWER_MANAGEMENT=y"
            ]
        }
    ]
}
